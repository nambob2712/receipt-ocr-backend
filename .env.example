# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/receipt_db

# Google Gemini API
GOOGLE_API_KEY=your_gemini_api_key_here

# JWT
JWT_SECRET=your_random_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# Cloudinary
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
